{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "autoint",
    "n_blocks": 3,
    "d_token": 114,
    "n_heads": 2,
    "attn_dropout": 0.2956,
    "ffn_factor": 2.711,
    "ffn_dropout": 0.3,
    "activation": "gelu"
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.000229,
    "weight_decay": 0.0,
    "scheduler": "plateau",
    "batch_size": 256,
    "epochs": 181,
    "patience": 11,
    "label_smoothing": 0.1404,
    "grad_clip": 3.418,
    "use_amp": true,
    "feature_noise_std": 0.127,
    "mixup_alpha": 0.2137
  }
}