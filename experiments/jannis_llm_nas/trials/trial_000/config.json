{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "mlp",
    "hidden_dims": [
      175
    ],
    "activation": "relu",
    "dropout": 0.3367,
    "normalization": "none",
    "embedding_dim": 45
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.000431,
    "weight_decay": 0.0,
    "scheduler": "plateau",
    "batch_size": 128,
    "epochs": 50,
    "patience": 25,
    "label_smoothing": 0.0845,
    "grad_clip": 1.389,
    "use_amp": true,
    "feature_noise_std": 0.1527,
    "mixup_alpha": 0.0409
  }
}