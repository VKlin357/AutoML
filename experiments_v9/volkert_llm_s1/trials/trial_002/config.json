{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "resmlp",
    "n_blocks": 6,
    "block_width": 512,
    "dropout": 0.4,
    "activation": "gelu",
    "normalization": "batchnorm",
    "embedding_dim": 64
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.0001,
    "weight_decay": 0.0,
    "scheduler": "cosine",
    "batch_size": 256,
    "epochs": 70,
    "patience": 8,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": false,
    "feature_noise_std": 0.0,
    "mixup_alpha": 0.0
  }
}