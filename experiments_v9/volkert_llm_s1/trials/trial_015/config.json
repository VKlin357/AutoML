{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "autoint",
    "n_blocks": 3,
    "d_token": 46,
    "n_heads": 2,
    "attn_dropout": 0.3,
    "residual_dropout": 0.05,
    "activation": "gelu",
    "embedding_dim": 45,
    "ffn_factor": 2.0,
    "ffn_dropout": 0.1
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.01,
    "weight_decay": 0.0,
    "scheduler": "cosine",
    "batch_size": 1024,
    "epochs": 120,
    "patience": 22,
    "label_smoothing": 0.1525,
    "grad_clip": 0.011,
    "use_amp": true,
    "feature_noise_std": 0.1443,
    "mixup_alpha": 0.0915
  }
}