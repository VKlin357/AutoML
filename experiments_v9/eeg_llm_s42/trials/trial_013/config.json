{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 2,
    "width": 678,
    "k": 7,
    "dropout": 0.2276,
    "head_dropout": 0.0397,
    "activation": "silu",
    "normalization": "layernorm",
    "embedding_dim": 60
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.000128,
    "weight_decay": 0.0,
    "scheduler": "plateau",
    "batch_size": 128,
    "epochs": 180,
    "patience": 29,
    "label_smoothing": 0.1109,
    "grad_clip": 4.659,
    "use_amp": true,
    "feature_noise_std": 0.1756,
    "mixup_alpha": 0.1058
  }
}