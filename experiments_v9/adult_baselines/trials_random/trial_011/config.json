{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "resmlp",
    "n_blocks": 4,
    "block_width": 367,
    "dropout": 0.1089,
    "activation": "relu",
    "normalization": "none",
    "embedding_dim": 51
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 1.5e-05,
    "weight_decay": 0.0,
    "scheduler": "none",
    "batch_size": 256,
    "epochs": 24,
    "patience": 19,
    "label_smoothing": 0.016,
    "grad_clip": 0.929,
    "use_amp": false,
    "feature_noise_std": 0.135,
    "mixup_alpha": 0.0941
  }
}