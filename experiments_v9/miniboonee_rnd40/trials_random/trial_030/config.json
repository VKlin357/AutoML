{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 3,
    "d_token": 122,
    "n_heads": 2,
    "ffn_factor": 2.021,
    "attn_dropout": 0.3521,
    "ffn_dropout": 0.2805,
    "residual_dropout": 0.0553,
    "activation": "gelu"
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.006985,
    "weight_decay": 0.0,
    "scheduler": "none",
    "batch_size": 1024,
    "epochs": 152,
    "patience": 27,
    "label_smoothing": 0.0481,
    "grad_clip": 2.38,
    "use_amp": false,
    "feature_noise_std": 0.0896,
    "mixup_alpha": 0.0069
  }
}