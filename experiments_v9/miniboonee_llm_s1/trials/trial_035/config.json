{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "autoint",
    "n_blocks": 4,
    "d_token": 128,
    "n_heads": 4,
    "attn_dropout": 0.3,
    "residual_dropout": 0.05,
    "activation": "gelu",
    "embedding_dim": 32,
    "ffn_factor": 2.0,
    "ffn_dropout": 0.1
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.01,
    "weight_decay": 0.002,
    "scheduler": "plateau",
    "batch_size": 512,
    "epochs": 134,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 0.5,
    "use_amp": false,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.2
  }
}