{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 4,
    "width": 512,
    "k": 8,
    "dropout": 0.3,
    "head_dropout": 0.2,
    "activation": "gelu",
    "normalization": "layernorm",
    "embedding_dim": 32
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.01,
    "weight_decay": 0.002,
    "scheduler": "plateau",
    "batch_size": 512,
    "epochs": 134,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 0.5,
    "use_amp": false,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.2
  }
}