{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "resmlp",
    "n_blocks": 8,
    "block_width": 256,
    "dropout": 0.2843,
    "activation": "leaky_relu",
    "normalization": "layernorm",
    "embedding_dim": 32
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.01,
    "weight_decay": 0.001,
    "scheduler": "plateau",
    "batch_size": 512,
    "epochs": 197,
    "patience": 22,
    "label_smoothing": 0.0,
    "grad_clip": 0.5,
    "use_amp": false,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.2
  }
}