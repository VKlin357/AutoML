{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 4,
    "d_token": 64,
    "n_heads": 4,
    "attn_dropout": 0.3,
    "ffn_factor": 2.0,
    "ffn_dropout": 0.1,
    "activation": "gelu",
    "residual_dropout": 0.1
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.01,
    "weight_decay": 0.001,
    "scheduler": "plateau",
    "batch_size": 512,
    "epochs": 100,
    "patience": 10,
    "label_smoothing": 0.0,
    "grad_clip": 0.5,
    "use_amp": false,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.2
  }
}