{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 4,
    "d_token": 128,
    "n_heads": 4,
    "ffn_factor": 1.0,
    "attn_dropout": 0.0,
    "ffn_dropout": 0.0,
    "residual_dropout": 0.1,
    "activation": "relu"
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.01,
    "weight_decay": 0.05,
    "scheduler": "cosine",
    "batch_size": 128,
    "epochs": 200,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": false,
    "feature_noise_std": 0.0,
    "mixup_alpha": 0.0
  }
}