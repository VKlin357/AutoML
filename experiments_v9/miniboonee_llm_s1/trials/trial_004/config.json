{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "gated_tab",
    "n_blocks": 1,
    "block_width": 64,
    "dropout": 0.5,
    "activation": "relu",
    "normalization": "none",
    "embedding_dim": 64
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.003,
    "weight_decay": 0.001,
    "scheduler": "none",
    "batch_size": 128,
    "epochs": 100,
    "patience": 10,
    "label_smoothing": 0.0,
    "grad_clip": 5.0,
    "use_amp": true,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.4
  }
}