{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "gated_tab",
    "n_blocks": 5,
    "block_width": 104,
    "dropout": 0.3097,
    "activation": "leaky_relu",
    "normalization": "none",
    "embedding_dim": 41
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.00037,
    "weight_decay": 0.0,
    "scheduler": "plateau",
    "batch_size": 256,
    "epochs": 77,
    "patience": 15,
    "label_smoothing": 0.0262,
    "grad_clip": 3.228,
    "use_amp": true,
    "feature_noise_std": 0.1858,
    "mixup_alpha": 0.3743
  }
}