{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 1,
    "d_token": 38,
    "n_heads": 2,
    "ffn_factor": 1.656,
    "attn_dropout": 0.2021,
    "ffn_dropout": 0.0106,
    "residual_dropout": 0.0398,
    "activation": "relu"
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.000431,
    "weight_decay": 0.0,
    "scheduler": "plateau",
    "batch_size": 128,
    "epochs": 50,
    "patience": 25,
    "label_smoothing": 0.0845,
    "grad_clip": 1.389,
    "use_amp": true,
    "feature_noise_std": 0.1527,
    "mixup_alpha": 0.0409
  }
}