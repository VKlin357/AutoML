{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 2,
    "width": 944,
    "k": 13,
    "dropout": 0.0831,
    "head_dropout": 0.0871,
    "activation": "gelu",
    "normalization": "layernorm",
    "embedding_dim": 20
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.007176,
    "weight_decay": 0.000345,
    "scheduler": "plateau",
    "batch_size": 1024,
    "epochs": 189,
    "patience": 13,
    "label_smoothing": 0.0993,
    "grad_clip": 0.571,
    "use_amp": true,
    "feature_noise_std": 0.0687,
    "mixup_alpha": 0.3185
  }
}