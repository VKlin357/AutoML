{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "gated_tab",
    "n_blocks": 6,
    "block_width": 533,
    "dropout": 0.0714,
    "activation": "gelu",
    "normalization": "batchnorm",
    "embedding_dim": 51
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.000414,
    "weight_decay": 1e-05,
    "scheduler": "none",
    "batch_size": 512,
    "epochs": 66,
    "patience": 7,
    "label_smoothing": 0.1019,
    "grad_clip": 0.455,
    "use_amp": true,
    "feature_noise_std": 0.0219,
    "mixup_alpha": 0.251
  }
}