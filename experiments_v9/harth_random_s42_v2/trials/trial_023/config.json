{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 3,
    "d_token": 136,
    "n_heads": 4,
    "ffn_factor": 2.628,
    "attn_dropout": 0.1663,
    "ffn_dropout": 0.0827,
    "residual_dropout": 0.084,
    "activation": "relu"
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 1.1e-05,
    "weight_decay": 0.000107,
    "scheduler": "none",
    "batch_size": 128,
    "epochs": 100,
    "patience": 12,
    "label_smoothing": 0.1507,
    "grad_clip": 4.267,
    "use_amp": false,
    "feature_noise_std": 0.0838,
    "mixup_alpha": 0.299
  }
}