{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "gated_tab",
    "n_blocks": 2,
    "block_width": 949,
    "dropout": 0.0813,
    "activation": "gelu",
    "normalization": "layernorm",
    "embedding_dim": 5
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.001621,
    "weight_decay": 0.032788,
    "scheduler": "onecycle",
    "batch_size": 512,
    "epochs": 50,
    "patience": 28,
    "label_smoothing": 0.1403,
    "grad_clip": 1.913,
    "use_amp": true,
    "feature_noise_std": 0.0941,
    "mixup_alpha": 0.0798
  }
}