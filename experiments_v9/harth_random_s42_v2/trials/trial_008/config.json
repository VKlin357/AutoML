{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 3,
    "width": 931,
    "k": 11,
    "dropout": 0.3634,
    "head_dropout": 0.0571,
    "activation": "gelu",
    "normalization": "batchnorm",
    "embedding_dim": 26
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.000171,
    "weight_decay": 0.0,
    "scheduler": "cosine",
    "batch_size": 128,
    "epochs": 113,
    "patience": 26,
    "label_smoothing": 0.0679,
    "grad_clip": 4.308,
    "use_amp": true,
    "feature_noise_std": 0.038,
    "mixup_alpha": 0.1794
  }
}