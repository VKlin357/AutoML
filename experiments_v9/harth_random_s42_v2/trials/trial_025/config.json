{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 3,
    "width": 179,
    "k": 8,
    "dropout": 0.1706,
    "head_dropout": 0.0635,
    "activation": "silu",
    "normalization": "batchnorm",
    "embedding_dim": 52
  },
  "train": {
    "optimizer": "adam",
    "lr": 6.8e-05,
    "weight_decay": 9e-06,
    "scheduler": "cosine",
    "batch_size": 1024,
    "epochs": 14,
    "patience": 26,
    "label_smoothing": 0.1079,
    "grad_clip": 5.0,
    "use_amp": true,
    "feature_noise_std": 0.13,
    "mixup_alpha": 0.3125
  }
}