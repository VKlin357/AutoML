{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "resmlp",
    "n_blocks": 5,
    "block_width": 507,
    "dropout": 0.2687,
    "activation": "relu",
    "normalization": "none",
    "embedding_dim": 59
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 5.5e-05,
    "weight_decay": 0.000595,
    "scheduler": "none",
    "batch_size": 1024,
    "epochs": 150,
    "patience": 11,
    "label_smoothing": 0.1083,
    "grad_clip": 4.256,
    "use_amp": true,
    "feature_noise_std": 0.0791,
    "mixup_alpha": 0.1355
  }
}