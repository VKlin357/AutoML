{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 5,
    "d_token": 56,
    "n_heads": 2,
    "ffn_factor": 3.333,
    "attn_dropout": 0.1312,
    "ffn_dropout": 0.2037,
    "residual_dropout": 0.133,
    "activation": "gelu"
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.009009,
    "weight_decay": 2e-06,
    "scheduler": "cosine",
    "batch_size": 512,
    "epochs": 42,
    "patience": 9,
    "label_smoothing": 0.0283,
    "grad_clip": 4.552,
    "use_amp": true,
    "feature_noise_std": 0.0632,
    "mixup_alpha": 0.3612
  }
}