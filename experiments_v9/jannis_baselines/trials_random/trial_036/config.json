{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 6,
    "d_token": 150,
    "n_heads": 2,
    "ffn_factor": 1.912,
    "attn_dropout": 0.161,
    "ffn_dropout": 0.1089,
    "residual_dropout": 0.108,
    "activation": "silu"
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.000622,
    "weight_decay": 0.001386,
    "scheduler": "plateau",
    "batch_size": 128,
    "epochs": 33,
    "patience": 10,
    "label_smoothing": 0.1924,
    "grad_clip": 4.18,
    "use_amp": false,
    "feature_noise_std": 0.1902,
    "mixup_alpha": 0.3998
  }
}