{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 2,
    "width": 128,
    "k": 16,
    "dropout": 0.2762,
    "head_dropout": 0.0393,
    "activation": "gelu",
    "normalization": "layernorm",
    "embedding_dim": 8
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.008,
    "weight_decay": 1e-05,
    "scheduler": "onecycle",
    "batch_size": 1024,
    "epochs": 200,
    "patience": 22,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": true,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.3
  }
}