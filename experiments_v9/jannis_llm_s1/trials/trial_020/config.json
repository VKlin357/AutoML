{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "autoint",
    "n_blocks": 2,
    "d_token": 32,
    "n_heads": 4,
    "attn_dropout": 0.3,
    "residual_dropout": 0.05,
    "activation": "gelu",
    "embedding_dim": 8,
    "ffn_factor": 2.0,
    "ffn_dropout": 0.1
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.008,
    "weight_decay": 1e-05,
    "scheduler": "cosine",
    "batch_size": 1024,
    "epochs": 200,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": true,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.3
  }
}