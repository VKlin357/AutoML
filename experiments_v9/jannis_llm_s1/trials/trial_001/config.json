{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "resmlp",
    "n_blocks": 6,
    "block_width": 512,
    "dropout": 0.4,
    "activation": "leaky_relu",
    "normalization": "batchnorm",
    "embedding_dim": 64
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.005,
    "weight_decay": 0.001,
    "scheduler": "plateau",
    "batch_size": 128,
    "epochs": 100,
    "patience": 10,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": true,
    "feature_noise_std": 0.0,
    "mixup_alpha": 0.1
  }
}