{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 6,
    "d_token": 128,
    "n_heads": 4,
    "ffn_factor": 2.0,
    "attn_dropout": 0.0,
    "ffn_dropout": 0.2,
    "residual_dropout": 0.1,
    "activation": "relu"
  },
  "train": {
    "optimizer": "adamw",
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "scheduler": "onecycle",
    "batch_size": 128,
    "epochs": 75,
    "patience": 3,
    "label_smoothing": 0.0,
    "grad_clip": 2.0,
    "use_amp": true,
    "feature_noise_std": 0.05,
    "mixup_alpha": 0.1
  }
}