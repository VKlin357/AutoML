{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "autoint",
    "n_blocks": 2,
    "d_token": 32,
    "n_heads": 2,
    "attn_dropout": 0.3,
    "ffn_factor": 1.0,
    "ffn_dropout": 0.2,
    "activation": "relu"
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.005,
    "weight_decay": 0.01,
    "scheduler": "none",
    "batch_size": 1024,
    "epochs": 30,
    "patience": 5,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": false,
    "feature_noise_std": 0.0,
    "mixup_alpha": 0.3
  }
}