{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "mlp",
    "hidden_dims": [
      16
    ],
    "activation": "relu",
    "dropout": 0.0,
    "normalization": "none",
    "embedding_dim": 4
  },
  "train": {
    "optimizer": "adamw",
    "lr": 1e-05,
    "weight_decay": 0.0001,
    "scheduler": "none",
    "batch_size": 256,
    "epochs": 50,
    "patience": 5,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": true,
    "feature_noise_std": 0.0,
    "mixup_alpha": 0.0
  }
}