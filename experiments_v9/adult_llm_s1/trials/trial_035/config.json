{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "gated_tab",
    "n_blocks": 4,
    "block_width": 128,
    "dropout": 0.3,
    "normalization": "layernorm",
    "embedding_dim": 16,
    "activation": "gelu"
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.002,
    "weight_decay": 1e-05,
    "scheduler": "cosine",
    "batch_size": 256,
    "epochs": 200,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "use_amp": true,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.0
  }
}