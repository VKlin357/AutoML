{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "mlp",
    "hidden_dims": [
      128,
      128,
      128,
      128
    ],
    "dropout": 0.3,
    "activation": "gelu",
    "normalization": "layernorm",
    "embedding_dim": 4
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.0015,
    "weight_decay": 1e-05,
    "scheduler": "cosine",
    "batch_size": 256,
    "epochs": 200,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "use_amp": true,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.0
  }
}