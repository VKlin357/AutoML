{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 4,
    "width": 512,
    "k": 8,
    "dropout": 0.4,
    "head_dropout": 0.2,
    "activation": "silu",
    "normalization": "batchnorm",
    "embedding_dim": 4
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.00254907,
    "weight_decay": 1e-05,
    "scheduler": "cosine",
    "batch_size": 256,
    "epochs": 200,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 1.0,
    "use_amp": true,
    "feature_noise_std": 0.1,
    "mixup_alpha": 0.0
  }
}