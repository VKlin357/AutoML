{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 5,
    "d_token": 66,
    "n_heads": 2,
    "ffn_factor": 2.481,
    "attn_dropout": 0.3023,
    "ffn_dropout": 0.3444,
    "residual_dropout": 0.0306,
    "activation": "gelu"
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.000185,
    "weight_decay": 0.0,
    "scheduler": "none",
    "batch_size": 1024,
    "epochs": 145,
    "patience": 11,
    "label_smoothing": 0.1942,
    "grad_clip": 4.304,
    "use_amp": true,
    "feature_noise_std": 0.1441,
    "mixup_alpha": 0.2727
  }
}