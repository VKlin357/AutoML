{
  "preprocess": {
    "num_encoder": "standard",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "gated_tab",
    "n_blocks": 1,
    "block_width": 888,
    "dropout": 0.1577,
    "activation": "silu",
    "normalization": "batchnorm",
    "embedding_dim": 17
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.004257,
    "weight_decay": 0.000387,
    "scheduler": "none",
    "batch_size": 1024,
    "epochs": 46,
    "patience": 11,
    "label_smoothing": 0.0279,
    "grad_clip": 3.725,
    "use_amp": false,
    "feature_noise_std": 0.1494,
    "mixup_alpha": 0.1714
  }
}