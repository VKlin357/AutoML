{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "resmlp",
    "n_blocks": 8,
    "block_width": 626,
    "dropout": 0.0826,
    "activation": "leaky_relu",
    "normalization": "batchnorm",
    "embedding_dim": 63
  },
  "train": {
    "optimizer": "sgd_momentum",
    "lr": 0.001844,
    "weight_decay": 0.000979,
    "scheduler": "none",
    "batch_size": 512,
    "epochs": 122,
    "patience": 19,
    "label_smoothing": 0.0903,
    "grad_clip": 1.24,
    "use_amp": true,
    "feature_noise_std": 0.0042,
    "mixup_alpha": 0.2216
  }
}