{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "ft_transformer",
    "n_blocks": 1,
    "d_token": 112,
    "n_heads": 8,
    "ffn_factor": 1.881,
    "attn_dropout": 0.0633,
    "ffn_dropout": 0.0013,
    "residual_dropout": 0.1444,
    "activation": "relu"
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.008235,
    "weight_decay": 3.6e-05,
    "scheduler": "cosine",
    "batch_size": 512,
    "epochs": 173,
    "patience": 19,
    "label_smoothing": 0.1218,
    "grad_clip": 0.764,
    "use_amp": false,
    "feature_noise_std": 0.1079,
    "mixup_alpha": 0.3115
  }
}