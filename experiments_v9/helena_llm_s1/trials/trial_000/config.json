{
  "preprocess": {
    "num_encoder": "none",
    "cat_encoder": "onehot"
  },
  "arch": {
    "family": "mlp",
    "hidden_dims": [
      64
    ],
    "activation": "relu",
    "dropout": 0.0,
    "normalization": "none",
    "embedding_dim": 4
  },
  "train": {
    "optimizer": "adamw",
    "lr": 1e-05,
    "weight_decay": 0.001,
    "scheduler": "none",
    "batch_size": 512,
    "epochs": 50,
    "patience": 10,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": false,
    "feature_noise_std": 0.0,
    "mixup_alpha": 0.0
  }
}