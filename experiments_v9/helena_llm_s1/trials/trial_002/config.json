{
  "preprocess": {
    "num_encoder": "quantile",
    "cat_encoder": "embedding"
  },
  "arch": {
    "family": "tabm",
    "n_blocks": 4,
    "width": 512,
    "k": 8,
    "dropout": 0.4,
    "head_dropout": 0.3,
    "activation": "silu",
    "normalization": "batchnorm",
    "embedding_dim": 64
  },
  "train": {
    "optimizer": "adam",
    "lr": 0.001,
    "weight_decay": 0.01,
    "scheduler": "plateau",
    "batch_size": 1024,
    "epochs": 100,
    "patience": 15,
    "label_smoothing": 0.0,
    "grad_clip": 0.0,
    "use_amp": false,
    "feature_noise_std": 0.0,
    "mixup_alpha": 0.0
  }
}